{
	"name": "ystandard",
	"version": "1.0.0",
	"author": "yosiakatuki",
	"license": "GPLv2",
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.21.0",
		"@wordpress/env": "^10.21.0",
		"@wordpress/prettier-config": "^4.21.0",
		"@wordpress/scripts": "^34.0.0",
		"@wp-playground/cli": "3.1.48",
		"autoprefixer": "^10.4.21",
		"browserslist": "^4.24.4",
		"cross-env": "^10.1.0",
		"css-declaration-sorter": "^7.2.0",
		"cssnano": "^7.0.6",
		"del": "^8.0.0",
		"husky": "^9.1.7",
		"npm-run-all": "^4.1.5",
		"po2json": "^1.0.0-beta-3",
		"postcss": "^8.5.23",
		"postcss-cli": "^11.0.1",
		"prettier": "npm:wp-prettier@^3.0.3",
		"rimraf": "^6.0.1",
		"sass": "^1.86.3",
		"sass-migrator": "^2.4.2",
		"simple-icons": "^14.12.1"
	},
	"scripts": {
		"wpenv:start:update": "wp-env start --xdebug=debug,develop -- --update",
		"wpenv:start": "wp-env start --xdebug=debug,develop",
		"wpenv:stop": "wp-env stop",
		"wpenv:destroy": "wp-env destroy",
		"watch:js": "cross-env NODE_ENV=development wp-scripts start",
		"watch:postcss:block-style": "postcss temp/css/block-styles/**/*.css --base temp/css/block-styles --dir css/block-styles --verbose -w",
		"watch:postcss:theme": "postcss temp/**/*.css --base temp/css --dir css --verbose -w",
		"watch:postcss": "run-p watch:postcss:*",
		"watch:css:block-style": "sass src/block-styles:temp/css/block-styles --no-source-map --no-stop-on-error -w",
		"watch:css:theme": "sass src/sass:temp/css --no-source-map --no-stop-on-error -w",
		"watch:css": "run-p watch:css:*",
		"watch": "run-p watch:*",
		"lint:js": "wp-scripts lint-js src/js/block-editor",
		"lint:php": "composer phpcs",
		"lint": "run-s lint:*",
		"build:js": "cross-env NODE_ENV=production wp-scripts build",
		"build:css:block-style": "sass src/block-styles:css/block-styles --no-source-map",
		"build:css:theme": "sass src/sass:css --no-source-map ",
		"build:css:postcss:theme": "postcss css/*.css -r && postcss css/**/*.css -r",
		"build:css:postcss:block-style": "postcss css/block-styles/**/*.css -r",
		"build:css:postcss": "run-s build:css:postcss:*",
		"build:css": "run-s build:css:*",
		"build:icons": "node ./src/js/icons/brand.js",
		"build": "run-s clean build:*",
		"test:php": "wp-playground-cli php --auto-mount --wp=6.9 --php=8.3 -- /wordpress/wp-content/themes/ystandard/vendor/bin/phpunit -c /wordpress/wp-content/themes/ystandard/phpunit.xml.dist",
		"test": "npm run test:php",
		"wpenv:test": "wp-env start && wp-env run tests-cli --env-cwd='wp-content/themes/ystandard' vendor/bin/phpunit -c phpunit.xml.dist",
		"clean:upload": "rimraf upload & rimraf /ystandard",
		"clean:css": "rimraf css",
		"clean:js": "rimraf js",
		"clean:zip": "rimraf ystandard.zip",
		"clean": "run-p clean:*",
		"i18n:pot": "wp i18n make-pot . languages/ystandard.pot --domain=\"ystandard\" --exclude=\"library,tests,vendor,bin\" --skip-js",
		"i18n:blocks": "po2json languages/ja.po languages/ystandard-ja-ys-block-editor-scripts.json -f jed",
		"zip:copy": "rsync -a --exclude='.*' --exclude='/node_modules' --exclude='/vendor' --exclude='/bin' --exclude='/upload' --exclude='/composer.*' --exclude='*.config.js' --exclude='*.config.json' --exclude='*.xml.dist' --exclude='/tests' --exclude='/src' --exclude='/temp' --exclude='package*.json' --exclude='ystandard-info*.json' . ystandard",
		"zip:archive": "zip -9 -qmr ystandard.zip ystandard",
		"zip": "run-s build clean:upload clean:zip zip:copy zip:archive",
		"mkdir:upload": "mkdir upload",
		"copy:json:production": "cp ystandard-info.json upload/ystandard-info.json",
		"copy:json:develop": "cp ystandard-info-beta.json upload/ystandard-info.json",
		"copy:theme": "cp ystandard.zip upload/ystandard.zip",
		"copy:production": "run-s mkdir:upload copy:json:production copy:theme",
		"copy:develop": "run-s mkdir:upload copy:json:develop copy:theme"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"dependencies": {
		"@wordpress/components": "^38.0.0",
		"@wordpress/core-data": "^7.52.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/editor": "^14.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0",
		"@wordpress/plugins": "^7.52.0"
	}
}
