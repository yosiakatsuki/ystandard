{
	"name": "ystandard",
	"version": "1.0.0",
	"author": "yosiakatuki",
	"license": "GPLv2",
	"files": [
		"*.php",
		"assets/",
		"block-styles.json",
		"css/",
		"inc/",
		"js/",
		"languages/",
		"library/",
		"page-template/",
		"template-parts/",
		"style.css",
		"theme.json",
		"screenshot.png",
		"LICENSE",
		"README.md"
	],
	"devDependencies": {
		"@wordpress/babel-preset-default": "^10.1.0",
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/browserslist-config": "^7.1.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/core-data": "^9.1.0",
		"@wordpress/editor": "^16.1.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/hooks": "^5.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/plugins": "^8.1.0",
		"@wordpress/prettier-config": "^5.1.0",
		"@wordpress/scripts": "^37.1.0",
		"@wp-playground/cli": "3.1.65",
		"autoprefixer": "^10.6.2",
		"css-declaration-sorter": "^7.4.0",
		"cssnano": "^9.9.0",
		"npm-run-all2": "^9.0.4",
		"postcss": "^8.5.33",
		"postcss-cli": "^12.0.0",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"sass": "^1.108.2",
		"simple-icons": "^16.38.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"scripts": {
		"watch:script:app": "wp-scripts start --config webpack.app.config.js",
		"watch:script": "run-p watch:script:*",
		"watch:css:postcss:block-style": "postcss temp/css/block-styles/**/*.css --base temp/css/block-styles --dir css/block-styles --verbose -w",
		"watch:css:postcss:theme": "postcss temp/**/*.css --base temp/css --dir css --verbose -w",
		"watch:css:postcss": "run-p watch:css:postcss:*",
		"watch:css:block-style": "sass src/block-styles:temp/css/block-styles --no-source-map --no-stop-on-error -w",
		"watch:css:theme": "sass src/styles:temp/css --no-source-map --no-stop-on-error -w",
		"watch:css": "run-p watch:css:*",
		"watch": "run-p watch:*",
		"lint:php": "composer phpcs",
		"lint:js": "wp-scripts lint-js src/scripts src/aktk-block-components",
		"lint:js:post-settings": "wp-scripts lint-js 'src/scripts/block-editor/post-settings/**/*.{ts,tsx}' 'src/aktk-block-components/wp-controls/{button,editor-pinned-button,modal,plugin-more-menu-item}/**/*.tsx'",
		"lint": "run-s lint:php lint:js",
		"build:script:app": "wp-scripts build --config webpack.app.config.js",
		"build:script": "run-s build:script:*",
		"build:css:block-style": "sass src/block-styles:css/block-styles --no-source-map",
		"build:css:theme": "sass src/styles:css --no-source-map ",
		"build:css:postcss:theme": "postcss css/*.css -r && postcss css/**/*.css -r",
		"build:css:postcss:block-style": "postcss css/block-styles/**/*.css -r",
		"build:css:postcss": "run-s build:css:postcss:*",
		"build:css": "run-s build:css:*",
		"build:icons": "node src/scripts/icons/brand.js",
		"build": "run-s clean build:*",
		"test:php": "wp-playground-cli php --mount=.:/wordpress/wp-content/themes/ystandard --wp=6.9 --php=8.3 -- /wordpress/wp-content/themes/ystandard/vendor/bin/phpunit -c /wordpress/wp-content/themes/ystandard/phpunit.xml.dist",
		"test:js:post-settings": "wp-scripts test-unit-js src/scripts/block-editor/post-settings",
		"test": "run-s test:php test:js:post-settings",
		"clean:upload": "rimraf upload",
		"clean:css": "rimraf css",
		"clean:js": "rimraf js",
		"clean:zip": "rimraf ystandard.zip",
		"clean": "run-p clean:*",
		"i18n:pot": "wp i18n make-pot . languages/ystandard.pot --domain=\"ystandard\" --exclude=\"library,tests,vendor,bin\" --skip-js",
		"i18n:blocks": "wp i18n make-json languages/ja.po languages --no-purge",
		"zip:archive": "wp-scripts plugin-zip --root-folder=ystandard",
		"zip": "run-s build zip:archive",
		"mkdir:upload": "mkdir upload",
		"copy:json:production": "cp ystandard-info.json upload/ystandard-info.json",
		"copy:json:develop": "cp ystandard-info-beta.json upload/ystandard-info.json",
		"copy:theme": "cp ystandard.zip upload/ystandard.zip",
		"copy:production": "run-s mkdir:upload copy:json:production copy:theme",
		"copy:develop": "run-s mkdir:upload copy:json:develop copy:theme"
	},
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": "^22.22.3 || ^24.15.0 || >=26.0.0",
		"npm": ">=10"
	}
}
